+/* The driver marks the client object it returns for every plugin open (NativeSandboxGrant) and marks its accelerator
+ * service (NativeSandboxGrantService); the service accepts only the plugin (0x4147) and the display hand-off (0x4148)
+ * connect types. Honor both in place of the sandbox verdict, so every process that runs the owner plugin (the render
+ * server, IconServices, PosterBoard, the poster extensions) may open its own device; other types stay sandboxed. */
+static bool
+native_client_sandbox_grant(IOUserClient * client)
+{
+	OSBoolean * grant = OSDynamicCast(OSBoolean, client->getProperty("NativeSandboxGrant"));
+	return grant && grant->getValue();
+}
+static bool
+native_service_sandbox_grant(IOService * service, uint32_t type)
+{
+	OSBoolean * grant = OSDynamicCast(OSBoolean, service->getProperty("NativeSandboxGrantService"));
+	return grant && grant->getValue() && (type == 0x4147 || type == 0x4148);
+}
