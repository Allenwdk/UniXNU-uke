@@ -91,6 +91,11 @@ static unsigned int panic_text_len;
 /* Whether a console is standing by for panic logging */
 static boolean_t panic_console_available = FALSE;
 
+/* Previous boot's embedded panic log, printed after the framebuffer console is up. */
+#define LAST_PANIC_TEXT_BYTES 2048
+static char last_panic_text[LAST_PANIC_TEXT_BYTES];
+static boolean_t last_panic_text_valid = FALSE;
+
 /* socd trace ram attributes */
