 	bzero((void *)gPanicBase, gPanicSize);
 }
 
+void
+pe_print_last_panic(void)
+{
+	printf("PREVIOUS XNU LOG (pram=%p size=%u valid=%d):\n%s\n",
+	    (void *)gPanicBase, gPanicSize, last_panic_text_valid ? 1 : 0,
+	    last_panic_text_valid ? last_panic_text : "(no previous log captured)");
+	last_panic_text_valid = FALSE;
+}
