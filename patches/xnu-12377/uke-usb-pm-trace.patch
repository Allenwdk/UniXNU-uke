+// USB bring-up observations from an independent thread. These deliberately do
+// not take the PM work-loop gate: a stuck gate must not stop the recorder.
+// Rows are best-effort snapshots, not an atomic transaction across the fields.
+void
+IOServicePM::ukeUsbSnapshot() const
+{
+	IOLog("[usb pm] snapshot name=%s unlocked=1 current=%u desired=%u max=%u count=%u highest=%u parents_known=%u flags=%lx machine=%u wait=%u driver_busy=%u timer=%d acks=%u request_empty=%u\n",
+	    Owner ? Owner->getName() : "none", (unsigned)CurrentPowerState,
+	    (unsigned)DesiredPowerState, (unsigned)MaxPowerState, (unsigned)NumberOfPowerStates,
+	    (unsigned)HighestPowerState, ParentsKnowState, (unsigned long)ParentsCurrentPowerFlags,
+	    MachineState, WaitReason, DriverCallBusy, DriverTimer, HeadNotePendingAcks,
+	    queue_empty(&RequestHead));
+}
+
+extern "C" int boot_flight_worker_stack(thread_t, uint64_t *, unsigned *, uint64_t *, uint64_t[12]) __attribute__((weak_import));
+extern "C" void boot_flight_cpu_status(uint64_t[32]) __attribute__((weak_import));
+
+static void
+uke_usb_pm_thread_snapshot(const char *role, IOWorkLoop *loop)
+{
+	thread_t thread = loop ? (thread_t)loop->getThread() : THREAD_NULL;
+	if (!thread || !boot_flight_worker_stack) {
+		IOLog("[usb pm] worker role=%s available=0\n", role);
+		return;
+	}
+	thread_reference(thread);
+	uint64_t tid = 0, event = 0, frames[12] = {};
+	unsigned state = 0;
+	const int locked = boot_flight_worker_stack(thread, &tid, &state, &event, frames);
+	thread_deallocate(thread);
+	IOLog("[usb pm] worker role=%s tid=%llu locked=%u state=%x event=%llx\n",
+	    role, (unsigned long long)tid, locked, state, (unsigned long long)event);
+	if (locked) {
+		for (unsigned i = 0; i < 12; i += 4) {
+			IOLog("[usb pm] stack role=%s group=%u pc=%llx/%llx/%llx/%llx\n", role, i / 4,
+			    (unsigned long long)frames[i], (unsigned long long)frames[i + 1],
+			    (unsigned long long)frames[i + 2], (unsigned long long)frames[i + 3]);
+		}
+	}
+}
+
+extern "C" void
+uke_usb_pm_snapshot(IOService *service)
+{
+	if (!service || !uke_usb_pm_enabled()) return;
+	OSObject *object = service->copyProperty("IOPowerManagement");
+	IOServicePM *pm = OSDynamicCast(IOServicePM, object);
+	IOLog("[usb pm] snapshot begin ticks=%llu pm_present=%u enqueued=%llu dequeued=%llu dispatch_in=%llu dispatch_out=%llu last_type=%u\n",
+	    (unsigned long long)mach_continuous_time(), pm != NULL,
+	    (unsigned long long)__atomic_load_n(&gUkePmEnqueued, __ATOMIC_RELAXED),
+	    (unsigned long long)__atomic_load_n(&gUkePmDequeued, __ATOMIC_RELAXED),
+	    (unsigned long long)__atomic_load_n(&gUkePmDispatchEntered, __ATOMIC_ACQUIRE),
+	    (unsigned long long)__atomic_load_n(&gUkePmDispatchReturned, __ATOMIC_ACQUIRE),
+	    __atomic_load_n(&gUkePmDispatchType, __ATOMIC_RELAXED));
+	char dispatchName[sizeof(gUkePmDispatchName)];
+	memcpy(dispatchName, gUkePmDispatchName, sizeof(dispatchName));
+	dispatchName[sizeof(dispatchName) - 1] = 0;
+	IOLog("[usb pm] snapshot last_target=%s\n", dispatchName);
+	IOLog("[usb pm] queues enabled request=%u reply=%u work=%u completion=%u\n",
+	    gIOPMRequestQueue && gIOPMRequestQueue->isEnabled(), gIOPMReplyQueue && gIOPMReplyQueue->isEnabled(),
+	    gIOPMWorkQueue && gIOPMWorkQueue->isEnabled(), gIOPMCompletionQueue && gIOPMCompletionQueue->isEnabled());
+	if (pm) pm->ukeUsbSnapshot();
+	OSSafeReleaseNULL(object);
+	IOService *root = IOService::getPMRootDomain();
+	object = root ? root->copyProperty("IOPowerManagement") : NULL;
+	pm = OSDynamicCast(IOServicePM, object);
+	if (pm) pm->ukeUsbSnapshot();
+	OSSafeReleaseNULL(object);
+#if WORK_QUEUE_STATS
+	if (gIOPMWorkQueue) {
+		IOLog("[usb pm] work stats check=%llu scan=%llu empty=%llu no_progress=%llu busy=%u invokes=%u\n",
+		    (unsigned long long)gIOPMWorkQueue->fStatCheckForWork,
+		    (unsigned long long)gIOPMWorkQueue->fStatScanEntries,
+		    (unsigned long long)gIOPMWorkQueue->fStatQueueEmpty,
+		    (unsigned long long)gIOPMWorkQueue->fStatNoWorkDone,
+		    gIOPMBusyRequestCount, gIOPMWorkInvokeCount);
+	}
+#endif
+	for (unsigned i = 0; i < 16; ++i) {
+		const uint32_t count = __atomic_load_n(&gUkeUsbPmRows[i], __ATOMIC_RELAXED);
+		const uint32_t limit = __atomic_load_n(&gUkeUsbPmLimits[i], __ATOMIC_RELAXED);
+		IOLog("[usb pm] coverage category=%u calls=%u limit=%u omitted=%u\n",
+		    i, count, limit, count > limit ? count - limit : 0);
+	}
+	uke_usb_pm_thread_snapshot("native-pm", gIOPMWorkLoop);
+	uke_usb_pm_thread_snapshot("apple-usb", service->getWorkLoop());
+	if (boot_flight_cpu_status) {
+		uint64_t cpu[32] = {};
+		boot_flight_cpu_status(cpu);
+		for (unsigned i = 0; i < 8; ++i) {
+			IOLog("[usb pm] cpu=%u state_pri=%llx signal=%llx active=%llx idle=%llu\n", i,
+			    (unsigned long long)cpu[4 * i], (unsigned long long)cpu[4 * i + 1],
+			    (unsigned long long)cpu[4 * i + 2], (unsigned long long)cpu[4 * i + 3]);
+		}
+	}
+	IOLog("[usb pm] snapshot end\n");
+}
