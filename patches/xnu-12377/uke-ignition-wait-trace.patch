 /* Bounded, opt-in observation of the unchanged AppleImage4 ignition handler. */
 TUNABLE(bool, uke_ignition_trace, "uke-ignition-trace", false);
 static unsigned uke_ignition_trace_queries;
+static thread_t uke_ignition_trace_thread;
+static unsigned uke_ignition_wait_counts[4];
+static bool uke_ignition_trace_busy;
+
+/* Observe only the active traced sysctl thread; no allocation or result change. */
+void
+uke_ignition_wait_trace(unsigned kind, uint64_t argument)
+{
+	thread_t traced = os_atomic_load(&uke_ignition_trace_thread, acquire);
+	if (kind < 1 || kind > 4 || traced == THREAD_NULL ||
+	    traced != current_thread() ||
+	    !os_atomic_cmpxchg(&uke_ignition_trace_busy, false, true, acquire)) {
+		return;
+	}
+	if (os_atomic_inc_orig(&uke_ignition_wait_counts[kind - 1], relaxed) < 2) {
+		static const char * const names[] = {"gate try-close", "gate result", "gate wait deadline", "IOSleep ms"};
+		kprintf("UKE IGN: %s %llu\n", names[kind - 1], (unsigned long long)argument);
+	}
+	os_atomic_store(&uke_ignition_trace_busy, false, release);
+}
 
