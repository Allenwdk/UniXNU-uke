 #define ARM64_PHYSMAP_SLIDE_RANGE (1ULL << 30) // 1 GB
 #define ARM64_PHYSMAP_SLIDE_MASK  (ARM64_PHYSMAP_SLIDE_RANGE - 1)
 
+/* The final EFI map supplies conventional DRAM outside the XNU window.
+ * Keep a private copy before the flattened device tree is retired. These
+ * ranges affect WC PTE attributes only, never VM page ownership. */
+struct uke_outside_dram_range {
+	uint64_t base;
+	uint64_t size;
+};
+
+static SECURITY_READ_ONLY_LATE(struct uke_outside_dram_range) uke_outside_dram[16];
+static SECURITY_READ_ONLY_LATE(unsigned int) uke_outside_dram_count;
+
+bool uke_outside_dram_contains(uint64_t base, uint64_t size);
+
+bool
+uke_outside_dram_contains(uint64_t base, uint64_t size)
+{
+	for (unsigned int i = 0; i < uke_outside_dram_count; i++) {
+		const struct uke_outside_dram_range *range = &uke_outside_dram[i];
+		uint64_t offset = base - range->base;
+		if (offset < range->size && size && size <= range->size - offset) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+uke_outside_dram_init(const boot_args *args)
+{
+	DTEntry chosen;
+	const void *data;
+	unsigned int bytes;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "darwinboot-memory-outside", &data, &bytes) != kSuccess) {
+		return;
+	}
+	if (!bytes || bytes > sizeof(uke_outside_dram) || bytes % sizeof(uke_outside_dram[0]) ||
+	    !args->memSize || args->physBase > UINT64_MAX - args->memSize) {
+		return;
+	}
+
+	uint64_t previous_end = 0;
+	unsigned int count = 0;
+	for (unsigned int offset = 0; offset < bytes; offset += sizeof(uke_outside_dram[0])) {
+		struct uke_outside_dram_range range;
+		memcpy(&range, (const uint8_t *)data + offset, sizeof(range));
+		if (!range.base && !range.size) {
+			continue;
+		}
+		if (!range.base || !range.size || ((range.base | range.size) & PAGE_MASK) ||
+		    range.base < previous_end || range.base > UINT64_MAX - range.size) {
+			return;
+		}
+		previous_end = range.base + range.size;
+		if (range.base < args->physBase + args->memSize && previous_end > args->physBase) {
+			return;
+		}
+		uke_outside_dram[count++] = range;
+	}
+	uke_outside_dram_count = count;
+}
