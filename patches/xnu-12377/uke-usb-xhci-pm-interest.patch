+// The Uke xHCI controller and the Apple ports under it consume their own
+// power notifications. Compare the concrete classes because arm64e thunks
+// hide the powerStateDidChangeTo override from the legacy test.
+static bool
+uke_xhci_needs_self_power_interest(IOService *service)
+{
+	const char *name = service->getMetaClass()->getClassName();
+	if (strcmp(name, "QcomDwc3Xhci") == 0) {
+		return true;
+	}
+	if (strcmp(name, "AppleUSB20XHCIPort") != 0 &&
+	    strcmp(name, "AppleUSB30XHCIPort") != 0 &&
+	    strcmp(name, "AppleUSB20HubPort") != 0 &&
+	    strcmp(name, "AppleUSB30HubPort") != 0) {
+		return false;
+	}
+
+	// A hub port can be below other hubs in the service plane.
+	for (IOService *provider = service->getProvider(); provider; provider = provider->getProvider()) {
+		if (strcmp(provider->getMetaClass()->getClassName(), "QcomDwc3Xhci") == 0) {
+			return true;
+		}
+	}
+	return false;
+}
