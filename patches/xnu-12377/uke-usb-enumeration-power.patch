+// Keep the port active while a USB device is attached to the Uke controller.
+// This also covers devices behind Apple hubs, which can idle their own ports.
+void
+IOService::ukeUSBUpdateAttachedPortPower(IOService *port, bool active)
+{
+	if (!port || strcmp(getMetaClass()->getClassName(), "IOUSBHostDevice") != 0) {
+		return;
+	}
+	const char *portClass = port->getMetaClass()->getClassName();
+	if (strcmp(portClass, "AppleUSB20XHCIPort") != 0 &&
+	    strcmp(portClass, "AppleUSB30XHCIPort") != 0 &&
+	    strcmp(portClass, "AppleUSB20HubPort") != 0 &&
+	    strcmp(portClass, "AppleUSB30HubPort") != 0) {
+		return;
+	}
+
+	IOService *provider = port->getProvider();
+	while (provider && strcmp(provider->getMetaClass()->getClassName(), "QcomDwc3Xhci") != 0) {
+		provider = provider->getProvider();
+	}
+	if (!provider) {
+		return;
+	}
+
+	char clientName[48];
+	snprintf(clientName, sizeof(clientName), "UkeUSBAttached-%llx", getRegistryEntryID());
+	OSSharedPtr<const OSSymbol> client(OSSymbol::withCString(clientName), OSNoRetain);
+	IOReturn result = client ? port->requestPowerState(client.get(), active ? 3 : 0) : kIOReturnNoMemory;
+	IOLog("[usb otg] %s attached port power device=%llx hold=%u result=%08x\n",
+	    portClass, getRegistryEntryID(), active, (unsigned int)result);
+}
