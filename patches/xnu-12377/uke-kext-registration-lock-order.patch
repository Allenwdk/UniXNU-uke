 static IORecursiveLock    * sKextLock                  = NULL;
 
+/* Deferred source classes must use the same order as OSKext::start:
+ * sKextLock before OSMetaClass's stalled-class lock, through postModLoad. */
+extern "C" void *uke_kext_class_begin(const char *identifier)
+{
+	IORecursiveLockLock(sKextLock);
+	void *handle = OSMetaClass::preModLoad(identifier);
+	if (!handle) {
+		IORecursiveLockUnlock(sKextLock);
+	}
+	return handle;
+}
+
+extern "C" OSReturn uke_kext_class_end(void *handle)
+{
+	OSReturn result = OSMetaClass::postModLoad(handle);
+	IORecursiveLockUnlock(sKextLock);
+	return result;
+}
+
