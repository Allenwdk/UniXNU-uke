+extern void uke_boot_stage(const char *);
+extern void uke_boot_stage_bind(uintptr_t, unsigned, unsigned, unsigned, unsigned);
+extern void uke_boot_stage_unbind(void);
+void uke_boot_stage_early_init(boot_args *);
+void uke_boot_stage_prepare(uint64_t, boot_args *);
+void uke_boot_stage_console_takeover(void);
+void uke_boot_stage_console_ready(uintptr_t, unsigned, unsigned, unsigned, unsigned);
+
+/* UKE_STAGE_MAP_CORE_BEGIN: compiled unchanged by the host boundary tests. */
+struct uke_stage_plan {
+	uint64_t va, pa, span, frame_pa, frame_va;
+	unsigned first, blocks;
+};
+
+static int
+uke_stage_plan_make(uint64_t va, uint64_t kernel_start, uint64_t frame,
+    uint64_t width, uint64_t height, uint64_t stride, uint64_t depth,
+    struct uke_stage_plan *out)
+{
+	const uint64_t block = ARM_TT_L2_SIZE;
+	if (width < 720 || width > 4096 || height < 600 || height > 4096 ||
+	    stride < width * 4 || stride > 65536 || (stride & 3) ||
+	    (depth & 0xffff) != 32 || !frame || (frame & 3) ||
+	    frame > UINT64_MAX - height * stride || (va & (block - 1))) {
+		return 0;
+	}
+	const uint64_t pa = frame & ~(block - 1);
+	const uint64_t length = frame - pa + height * stride;
+	const uint64_t span = (length + block - 1) & ~(block - 1);
+	/* Reserve only the empty low-globals gap, not any kernel or heap VA. */
+	if (va < LOW_GLOBAL_BASE_ADDRESS + block || span > 32 * block ||
+	    va > UINT64_MAX - span || va + span > (kernel_start & ~(block - 1)) ||
+	    ((va ^ (va + span - 1)) >> ARM_TT_L1_SHIFT) != 0) {
+		return 0;
+	}
+	*out = (struct uke_stage_plan){va, pa, span, frame, va + frame - pa,
+	    (unsigned)L2_TABLE_INDEX(va), (unsigned)(span / block)};
+	return 1;
+}
+
+static uint64_t
+uke_stage_descriptor(const struct uke_stage_plan *plan, unsigned i)
+{
+	return (plan->pa + (uint64_t)i * ARM_TT_L2_SIZE) |
+	       ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK | ARM_TTE_BLOCK_AF |
+	       ARM_TTE_BLOCK_AP(AP_RWNA) | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+	       ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+	       ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+}
+
+static int
+uke_stage_install(volatile uint64_t *l2, const struct uke_stage_plan *plan)
+{
+	if (!plan->blocks || plan->first + plan->blocks > TTE_PGENTRIES) {
+		return 0;
+	}
+	/* Validate the whole run before changing even the first descriptor. */
+	for (unsigned i = 0; i < plan->blocks; ++i) {
+		if (l2[plan->first + i] != ARM_TTE_EMPTY) {
+			return 0;
+		}
+	}
+	for (unsigned i = 0; i < plan->blocks; ++i) {
+		l2[plan->first + i] = uke_stage_descriptor(plan, i);
+	}
+	return 1;
+}
+
+static void
+uke_stage_remove(volatile uint64_t *l2, const struct uke_stage_plan *plan)
+{
+	for (unsigned i = 0; i < plan->blocks; ++i) {
+		/* Never remove an entry that no longer belongs to this diagnostic. */
+		if (l2[plan->first + i] == uke_stage_descriptor(plan, i)) {
+			l2[plan->first + i] = ARM_TTE_EMPTY;
+		}
+	}
+}
+/* UKE_STAGE_MAP_CORE_END */
+
+_Static_assert(ARM_TT_L1_SHIFT == 30 && ARM_TT_L2_SHIFT == 21 &&
+    ARM_PGBYTES == 4096 && (T1SZ_BOOT == 25 || T1SZ_BOOT == 26), "uke stage alias needs the 4K/38-39-bit TTBR1 geometry");
+#if XNU_MONITOR || CONFIG_SPTM || defined(ARM_LARGE_MEMORY) || defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
+#error "uke stage alias is only reviewed for this non-PPL/non-SPTM uke target"
+#endif
+
+static struct uke_stage_plan uke_stage_mapping;
+static pmap_paddr_t uke_stage_roots[2];
+
+/* AT reports faults in PAR_EL1; it does not perform a speculative data access. */
+static int
+uke_stage_writable(uint64_t va, uint64_t pa, uint64_t size)
+{
+	if (!size || va > UINT64_MAX - size || pa > UINT64_MAX - size) {
+		return 0;
+	}
+	for (uint64_t offset = 0; offset < size;) {
+		uint64_t par;
+		const uint64_t at = va + offset;
+		__asm__ volatile("at s1e1w, %1\n\tisb\n\tmrs %0, par_el1" : "=r"(par) : "r"(at) : "memory");
+		if ((par & 1) || ((par & ARM_TTE_TABLE_MASK) | (at & 0xfff)) != pa + offset) {
+			return 0;
+		}
+		const uint64_t next = offset + 4096 - (at & 0xfff);
+		/* Also check the last byte when the mapping ends within a page. */
+		if (offset == size - 1) {
+			break;
+		}
+		offset = next < size ? next : size - 1;
+	}
+	return 1;
+}
+
+static void
+uke_stage_sync(void)
+{
+	__asm__ volatile("dsb ishst\n\ttlbi vmalle1is\n\tdsb ish\n\tisb" ::: "memory");
+}
+
+static volatile uint64_t *
+uke_stage_l2(pmap_paddr_t root, const boot_args *args)
+{
+	/* Before the TTBR1 switch use boot_args' linear mapping, not the new physmap. */
+	if (!root || root < args->physBase || root - args->physBase > args->memSize - 4096) {
+		return NULL;
+	}
+	uint64_t root_va = args->virtBase + root - args->physBase;
+	if (!uke_stage_writable(root_va, root, 4096)) {
+		return NULL;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)root_va;
+	const uint64_t tte = l1[L1_TABLE_T1_INDEX(uke_stage_mapping.va, TCR_EL1_BOOT)];
+	if ((tte & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) != (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		return NULL;
+	}
+	const uint64_t pa = tte & ARM_TTE_TABLE_MASK;
+	if (pa < args->physBase || pa - args->physBase > args->memSize - 4096) {
+		return NULL;
+	}
+	const uint64_t va = args->virtBase + pa - args->physBase;
+	return uke_stage_writable(va, pa, 4096) ? (volatile uint64_t *)va : NULL;
+}
+
+void
+uke_boot_stage_early_init(boot_args *args)
+{
+	const Boot_Video *v = &args->Video;
+	if (args->memSize < 4096 ||
+	    !uke_stage_plan_make(LOW_GLOBAL_BASE_ADDRESS + ARM_TT_L2_SIZE, args->virtBase,
+	    v->v_baseAddr & ~3ULL, v->v_width, v->v_height, v->v_rowBytes, v->v_depth,
+	    &uke_stage_mapping)) {
+		uke_boot_stage("LIVE1: alias plan rejected (no framebuffer writes)");
+		return;
+	}
+	/* This board's splash RAM must stay outside XNU-managed high DRAM. */
+	if (uke_stage_mapping.pa + uke_stage_mapping.span > args->physBase ||
+	    ((__builtin_arm_rsr64("TCR_EL1") ^ TCR_EL1_BOOT) &
+	    ((TCR_T1SZ_MASK << TCR_T1SZ_SHIFT) | (3ULL << 30))) ||
+	    ((__builtin_arm_rsr64("MAIR_EL1") >> (CACHE_ATTRINDX_WRITECOMB * 8)) & 0xff) != 0x44) {
+		uke_boot_stage("LIVE1: geometry/MAIR rejected (no framebuffer writes)");
+		return;
+	}
+	const pmap_paddr_t root = __builtin_arm_rsr64("TTBR1_EL1") & ARM_TTE_TABLE_MASK;
+	volatile uint64_t *l2 = uke_stage_l2(root, args);
+	if (!l2 || !uke_stage_install(l2, &uke_stage_mapping)) {
+		uke_boot_stage("LIVE1: boot L2 occupied/unmapped (no writes)");
+		return;
+	}
+	uke_stage_roots[0] = root;
+	uke_stage_sync();
+	if (!uke_stage_writable(uke_stage_mapping.frame_va, uke_stage_mapping.frame_pa, v->v_height * v->v_rowBytes)) {
+		uke_stage_remove(l2, &uke_stage_mapping);
+		uke_stage_sync();
+		uke_stage_roots[0] = 0;
+		return;
+	}
+	uke_boot_stage_bind(uke_stage_mapping.frame_va, (unsigned)v->v_width, (unsigned)v->v_height,
+	    (unsigned)v->v_rowBytes, (unsigned)(v->v_depth & 0xff));
+	uke_boot_stage("LIVE1: static_if returned; boot alias verified");
+}
+
+void
+uke_boot_stage_prepare(uint64_t root, boot_args *args)
+{
+	if (!uke_stage_roots[0]) {
+		return;
+	}
+	volatile uint64_t *l2 = uke_stage_l2(root, args);
+	if (!l2 || !uke_stage_install(l2, &uke_stage_mapping)) {
+		uke_boot_stage("LIVE1 ERROR: new L2 conflict; live output disabled");
+		uke_boot_stage_unbind();
+		return;
+	}
+	uke_stage_roots[1] = root;
+	__asm__ volatile("dsb ishst" ::: "memory");
+	uke_boot_stage("LIVE1: new TTBR1 alias installed");
+}
+
+/* Retire both copies before normal console mapping may choose different MAIR attributes. */
+void
+uke_boot_stage_console_takeover(void)
+{
+	if (!uke_stage_roots[0] && !uke_stage_roots[1]) {
+		return;
+	}
+	uke_boot_stage("LIVE1: normal console mapping enter; retiring alias");
+	uke_boot_stage_unbind();
+	for (unsigned i = 0; i < 2; ++i) {
+		if (!uke_stage_roots[i]) {
+			continue;
+		}
+		const uint64_t *l1 = (const uint64_t *)phystokv(uke_stage_roots[i]);
+		const uint64_t tte = l1[L1_TABLE_T1_INDEX(uke_stage_mapping.va, TCR_EL1_BOOT)];
+		if ((tte & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+			uke_stage_remove((volatile uint64_t *)phystokv(tte & ARM_TTE_TABLE_MASK), &uke_stage_mapping);
+		}
+		uke_stage_roots[i] = 0;
+	}
+	uke_stage_sync();
+}
+
+void
+uke_boot_stage_console_ready(uintptr_t frame, unsigned width, unsigned height,
+    unsigned stride, unsigned depth)
+{
+	if (uke_stage_mapping.frame_pa && depth == 32 && width <= 4096 && height <= 4096 &&
+	    stride <= 65536 && uke_stage_writable(frame, uke_stage_mapping.frame_pa, (uint64_t)height * stride)) {
+		uke_boot_stage_bind(frame, width, height, stride, depth);
+		uke_boot_stage("LIVE1: normal console VA verified");
+		uke_boot_stage_unbind();
+		uke_stage_mapping.frame_pa = 0; /* Retired permanently after normal console takeover. */
+	}
+}
+
