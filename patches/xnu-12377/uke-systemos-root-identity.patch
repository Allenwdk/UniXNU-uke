 char native_owner_cache_device_path[64];
+#if defined(XNU_OWNER_UNION_SYSTEMOS) && XNU_OWNER_UNION_SYSTEMOS
+volatile int native_owner_cache_rootfs_status = -1;
+volatile uint64_t native_owner_cache_rootfs_before = 0;
+volatile uint64_t native_owner_cache_rootfs_after = 0;
+
+/* The readonly SystemOS union has become rootvnode, but mount() does not give
+ * a union above '/' MNT_ROOTFS. Publish the real root mount's identity only
+ * after both original volume policies and the boot manifest have succeeded.
+ * Never apply this to a bindfs view, Data, or an unrelated APFS mount. */
+static int
+native_owner_cache_publish_rootfs(vnode_t original_root, vnode_t mounted_root,
+    dev_t expected_root, dev_t expected_cache, const char *volume)
+{
+	if (!original_root || !mounted_root || original_root == mounted_root ||
+	    mounted_root != rootvnode || !vnode_isvroot(original_root) || !vnode_isvroot(mounted_root)) {
+		return EAUTH;
+	}
+	mount_t lower = vnode_mount(original_root), upper = vnode_mount(mounted_root);
+	if (!lower || !upper || lower == upper || vnode_mountedhere(original_root) != upper ||
+	    strcmp(vfs_statfs(lower)->f_fstypename, "apfs") || strcmp(vfs_statfs(upper)->f_fstypename, "apfs") ||
+	    (vfs_flags(lower) & (MNT_RDONLY | MNT_ROOTFS)) != (MNT_RDONLY | MNT_ROOTFS) ||
+	    (vfs_flags(upper) & (MNT_RDONLY | MNT_UNION)) != (MNT_RDONLY | MNT_UNION)) {
+		return EAUTH;
+	}
+	dev_t root_device = NODEV, cache_device = NODEV, selected = NODEV;
+	char device_path[64];
+	vnode_t device = vfs_devvp(lower);
+	if (device) {
+		root_device = vnode_specrdev(device);
+		vnode_put(device);
+	}
+	device = vfs_devvp(upper);
+	if (device) {
+		cache_device = vnode_specrdev(device);
+		vnode_put(device);
+	}
+	if (expected_root == NODEV || expected_cache == NODEV || expected_root == expected_cache ||
+	    root_device != expected_root || cache_device != expected_cache ||
+	    !native_verified_block_volume_device(volume, &selected, device_path, sizeof(device_path)) ||
+	    selected != cache_device || !native_verified_block_root_authorized(root_device) ||
+	    !native_verified_block_root_authorized(cache_device)) {
+		return EAUTH;
+	}
+	native_owner_cache_rootfs_before = vfs_flags(upper);
+	vfs_setflags(upper, MNT_ROOTFS);
+	native_owner_cache_rootfs_after = vfs_flags(upper);
+	return native_owner_cache_rootfs_after == (native_owner_cache_rootfs_before | MNT_ROOTFS) ? 0 : EAUTH;
+}
