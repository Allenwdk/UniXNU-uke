+/*
+ * Keep this optional UPL batching buffer out of the general zone allocator.
+ * Z_NOWAIT can still wait for a zone ticket lock. The callers already handle
+ * NULL with one delayed work entry on their stack, so never wait for a slot.
+ */
+#define UKE_DW_CTX_SLOTS 16u
+static struct vm_page_delayed_work_ctx uke_dw_ctx_pool[UKE_DW_CTX_SLOTS];
+static uint32_t uke_dw_ctx_used;
+static uint64_t uke_dw_ctx_gets, uke_dw_ctx_puts;
+
+void uke_vm_dw_pool_snapshot(uint64_t out[4])
+{
+	out[0] = os_atomic_load(&uke_dw_ctx_used, relaxed);
+	out[1] = os_atomic_load(&uke_dw_ctx_gets, relaxed);
+	out[2] = os_atomic_load(&uke_dw_ctx_puts, relaxed);
+	out[3] = os_atomic_load(&vm_page_delayed_work_ctx_needed, relaxed);
+}
+_Static_assert(offsetof(struct vm_page_delayed_work_ctx, dwp) == 0, "delayed work layout");
