+#if defined(XNU_TARGET_OS_IOS)
+extern void vm_swap_owner_data_ready(void);
+
+static void
+native_owner_data_prepare_swap(proc_t p, user_addr_t scratch, vnode_t data_root)
+{
+	static const char directory[] = "/private/var/vm";
+	struct mkdir_args request = {.path = scratch + 0xc00, .mode = 0755};
+	int32_t result = 0;
+	vnode_t swap_dir = NULLVP;
+	int error = copyout(directory, request.path, sizeof(directory));
+	if (!error) {
+		error = mkdir(p, &request, &result);
+	}
+	if (error == EEXIST) {
+		error = 0;
+	}
+	if (!error) {
+		error = vnode_lookupat("vm", VNODE_LOOKUP_NOFOLLOW_ANY | VNODE_LOOKUP_NOCROSSMOUNT,
+		    &swap_dir, vfs_context_current(), data_root);
+		if (!error) {
+			error = vnode_isdir(swap_dir) ? 0 : ENOTDIR;
+			vnode_put(swap_dir);
+		}
+	}
+	printf("owner Data: %s swap directory status %d\n", directory, error);
+	if (!error) {
+		vm_swap_owner_data_ready();
+	}
+}
+#endif
