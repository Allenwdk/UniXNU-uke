diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 46a2477..1dafb1c 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -3721,6 +3721,41 @@ quotactl(__unused proc_t p, __unused struct quotactl_args *uap, __unused int32_t
 #endif /* QUOTA */
 
 TUNABLE(bool, uke_files_volume_trace, "uke-files-volume-trace", false);
+TUNABLE(bool, uke_files_union_view, "uke-files-union-view", false);
+
+mount_t uke_files_union_identity(mount_t mp);
+
+// Same upper-root view as the macOS owner-union implementation, scoped to
+// Files on iPadOS so existing system clients keep their current volume view.
+static mount_t
+uke_files_union_top(void)
+{
+	if (!uke_files_union_view) {
+		return NULL;
+	}
+	proc_t p = vfs_context_proc(vfs_context_current());
+	if (!p || strcmp(p->p_comm, "Files") != 0) {
+		return NULL;
+	}
+	mount_t top = rootvnode ? vnode_mount(rootvnode) : NULL;
+	if (!top || !(top->mnt_flag & MNT_UNION) || !top->mnt_vnodecovered ||
+	    !(top->mnt_vnodecovered->v_flag & VROOT)) {
+		return NULL;
+	}
+	mount_t lower = vnode_mount(top->mnt_vnodecovered);
+	return lower && lower != top && (lower->mnt_flag & MNT_ROOTFS) ? top : NULL;
+}
+
+mount_t
+uke_files_union_identity(mount_t mp)
+{
+	if (!mp || !(mp->mnt_flag & MNT_ROOTFS)) {
+		return mp;
+	}
+	mount_t top = uke_files_union_top();
+	return top && vnode_mount(top->mnt_vnodecovered) == mp ? top : mp;
+}
