+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef UKE_CPU_STALL_H
+#define UKE_CPU_STALL_H
+
+#include <stdint.h>
+
+/* Fixed storage only. A row is written by its own CPU with IRQs masked. */
+struct uke_cpu_stall_record {
+    uint64_t sequence;
+    uint64_t irq_entries;
+    uint64_t irq_exits;
+    uint64_t entered_at;
+    uint64_t pc;
+    uint64_t cpsr;
+    uint64_t sp;
+    uint64_t fp;
+    uint64_t thread;
+    uint64_t phase;
+    uint64_t masked_at;
+    uint64_t masked_caller;
+    uint64_t masked_sp;
+    uint64_t masked_thread;
+} __attribute__((aligned(128)));
+
+extern unsigned int uke_cpu_stall_enabled;
+void uke_cpu_stall_irq_enter(uint64_t pc, uint64_t cpsr, uint64_t sp, uint64_t fp);
+void uke_cpu_stall_irq_exit(void);
+void uke_cpu_stall_phase(uint64_t phase);
+void uke_cpu_stall_mask_begin(uint64_t caller, uint64_t sp);
+void uke_cpu_stall_mask_end(void);
+int uke_cpu_stall_snapshot(unsigned int cpu, struct uke_cpu_stall_record *out);
+
+#endif
