+
+/* CPU-only freeze observations, independent of the optional GPU recorder. */
+unsigned int uke_cpu_stall_enabled;
+static struct uke_cpu_stall_record uke_cpu_stall_records[8];
+
+static void
+uke_cpu_stall_init(void)
+{
+    unsigned int enabled = 0;
+    PE_parse_boot_argn("uke-cpu-stall", &enabled, sizeof(enabled));
+    uke_cpu_stall_enabled = enabled == 1;
+}
+STARTUP(TUNABLES, STARTUP_RANK_LAST, uke_cpu_stall_init);
+
+static struct uke_cpu_stall_record *
+uke_cpu_stall_begin(void)
+{
+    struct uke_cpu_stall_record *row =
+        &uke_cpu_stall_records[getCpuDatap()->cpu_number & 7];
+    __atomic_fetch_add(&row->sequence, 1ULL, __ATOMIC_ACQ_REL);
+    return row;
+}
+
+static void
+uke_cpu_stall_end(struct uke_cpu_stall_record *row)
+{
+    __atomic_fetch_add(&row->sequence, 1ULL, __ATOMIC_RELEASE);
+}
+
+void
+uke_cpu_stall_irq_enter(uint64_t pc, uint64_t cpsr, uint64_t sp, uint64_t fp)
+{
+    struct uke_cpu_stall_record *row = uke_cpu_stall_begin();
+    __atomic_fetch_add(&row->irq_entries, 1ULL, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->entered_at, mach_absolute_time(), __ATOMIC_RELAXED);
+    __atomic_store_n(&row->pc, pc, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->cpsr, cpsr, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->sp, sp, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->fp, fp, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->thread, (uintptr_t)current_thread(), __ATOMIC_RELAXED);
+    __atomic_store_n(&row->phase, 1ULL, __ATOMIC_RELAXED);
+    uke_cpu_stall_end(row);
+}
+
+void
+uke_cpu_stall_irq_exit(void)
+{
+    struct uke_cpu_stall_record *row = uke_cpu_stall_begin();
+    __atomic_fetch_add(&row->irq_exits, 1ULL, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->phase, 0ULL, __ATOMIC_RELAXED);
+    uke_cpu_stall_end(row);
+}
+
+void
+uke_cpu_stall_phase(uint64_t phase)
+{
+    struct uke_cpu_stall_record *row = uke_cpu_stall_begin();
+    __atomic_store_n(&row->phase, phase, __ATOMIC_RELAXED);
+    uke_cpu_stall_end(row);
+}
+
+void
+uke_cpu_stall_mask_begin(uint64_t caller, uint64_t sp)
+{
+    struct uke_cpu_stall_record *row = uke_cpu_stall_begin();
+    __atomic_store_n(&row->masked_at, mach_absolute_time(), __ATOMIC_RELAXED);
+    __atomic_store_n(&row->masked_caller, caller, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->masked_sp, sp, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->masked_thread, (uintptr_t)current_thread(), __ATOMIC_RELAXED);
+    uke_cpu_stall_end(row);
+}
+
+void
+uke_cpu_stall_mask_end(void)
+{
+    struct uke_cpu_stall_record *row = uke_cpu_stall_begin();
+    __atomic_store_n(&row->masked_at, 0ULL, __ATOMIC_RELAXED);
+    uke_cpu_stall_end(row);
+}
+
+int
+uke_cpu_stall_snapshot(unsigned int cpu, struct uke_cpu_stall_record *out)
+{
+    if (!uke_cpu_stall_enabled || cpu >= 8 || out == NULL) {
+        return 0;
+    }
+    const struct uke_cpu_stall_record *row = &uke_cpu_stall_records[cpu];
+    const uint64_t before = __atomic_load_n(&row->sequence, __ATOMIC_ACQUIRE);
+    if (before & 1) {
+        return 0;
+    }
+#define UKE_STALL_COPY(field) out->field = __atomic_load_n(&row->field, __ATOMIC_RELAXED)
+    UKE_STALL_COPY(irq_entries);
+    UKE_STALL_COPY(irq_exits);
+    UKE_STALL_COPY(entered_at);
+    UKE_STALL_COPY(pc);
+    UKE_STALL_COPY(cpsr);
+    UKE_STALL_COPY(sp);
+    UKE_STALL_COPY(fp);
+    UKE_STALL_COPY(thread);
+    UKE_STALL_COPY(phase);
+    UKE_STALL_COPY(masked_at);
+    UKE_STALL_COPY(masked_caller);
+    UKE_STALL_COPY(masked_sp);
+    UKE_STALL_COPY(masked_thread);
+#undef UKE_STALL_COPY
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    out->sequence = __atomic_load_n(&row->sequence, __ATOMIC_ACQUIRE);
+    return before == out->sequence;
+}
+
