+/*
+ * The Uke timeout photo identifies pset 0 but contains only the waiter stack.
+ * Keep its acquisition site while the existing lock serializes writers.
+ * Readers use the sequence, advisory owner and ticket to reject handoffs.
+ * No allocation, output, scheduler entry or foreign stack access occurs here.
+ */
+struct uke_pset_lock_owner {
+	uint64_t sequence;
+	uint64_t acquired;
+	uintptr_t owner;
+	uintptr_t caller[3];
+	uint32_t ticket;
+};
+static struct uke_pset_lock_owner uke_pset_owner;
+extern struct processor_set pset_array_actual[MAX_PSETS];
+
+static void __attribute__((noinline))
+uke_pset_lock_acquired(lck_ticket_t *lock, thread_t thread, uintptr_t caller, uintptr_t frame)
+{
+	if (lock != &pset_array_actual[0].sched_lock) {
+		return;
+	}
+
+	uint64_t sequence = os_atomic_load(&uke_pset_owner.sequence, relaxed);
+	os_atomic_store(&uke_pset_owner.sequence, sequence + 1, relaxed);
+	os_atomic_thread_fence(release);
+	os_atomic_store(&uke_pset_owner.acquired, mach_absolute_time(), relaxed);
+	os_atomic_store(&uke_pset_owner.owner, (uintptr_t)thread, relaxed);
+	os_atomic_store(&uke_pset_owner.ticket, lock->tu.cticket, relaxed);
+	os_atomic_store(&uke_pset_owner.caller[0], caller, relaxed);
+	os_atomic_store(&uke_pset_owner.caller[1], 0, relaxed);
+	os_atomic_store(&uke_pset_owner.caller[2], 0, relaxed);
+
+	/* Walk only this thread's own bounded kernel stack. Early boot and
+	 * interrupt-stack frames retain the direct caller without a walk. */
+	uintptr_t low = thread->kernel_stack;
+	uintptr_t size = kernel_stack_size;
+	for (unsigned int i = 1; i < 3 && low && size >= 16 &&
+	    frame >= low && frame - low <= size - 16 && !(frame & 15); i++) {
+		uintptr_t next = ((const uintptr_t *)frame)[0];
+		if (next <= frame || next < low || next - low > size - 16 || (next & 15)) {
+			break;
+		}
+		frame = next;
+		os_atomic_store(&uke_pset_owner.caller[i], ((const uintptr_t *)frame)[1], relaxed);
+	}
+	os_atomic_store(&uke_pset_owner.sequence, sequence + 2, release);
+}
+
+static struct uke_pset_lock_owner
+uke_pset_lock_snapshot(lck_ticket_t *lock, uintptr_t owner, uint32_t ticket)
+{
+	struct uke_pset_lock_owner copy = {};
+	uint64_t sequence = os_atomic_load(&uke_pset_owner.sequence, acquire);
+	if (lock != &pset_array_actual[0].sched_lock || (sequence & 1)) {
+		return copy;
+	}
+	copy.acquired = os_atomic_load(&uke_pset_owner.acquired, relaxed);
+	copy.owner = os_atomic_load(&uke_pset_owner.owner, relaxed);
+	copy.ticket = os_atomic_load(&uke_pset_owner.ticket, relaxed);
+	for (unsigned int i = 0; i < 3; i++) {
+		copy.caller[i] = os_atomic_load(&uke_pset_owner.caller[i], relaxed);
+	}
+	os_atomic_thread_fence(acquire);
+	if (sequence != os_atomic_load(&uke_pset_owner.sequence, relaxed) ||
+	    copy.owner != owner || copy.ticket != ticket) {
+		return (struct uke_pset_lock_owner){};
+	}
+	copy.sequence = sequence;
+	return copy;
+}
