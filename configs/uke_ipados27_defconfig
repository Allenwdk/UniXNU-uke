# uke / iPadOS 27.0.1 (24A446), arm64e.
#
# Phase 1 build gate: the shared arm64e and 24A446 profiles carry the kernel
# configuration; this defconfig only fixes the target-specific switches until
# the source-storage and display archives are ported. Board archives stay off
# so the link gate is the untreated XNU 12377 source build.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_DT_PANIC_REGION=y
# The owned GopFramebuffer legacy display backend (CPU composition, GOP/DPU presentation).
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

# The GPU is off in the first CPU-rendering milestone: no NATIVE_ADRENO, no Metal
# addon. Re-enable together with the Adreno740/AdrenoMetal feat archives.
# CONFIG_XNU_NATIVE_ADRENO is not set

# Source storage: the UFS runtime is built from the public IOStorageFamily source and authenticates the
# 24A446 OS policy. Only the signed headers travel in the payload; the hash table is the OS.vroot data object
# of the userdata image. Data/SystemOS mount with their own images and seed.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_SOURCE_STORAGE_TABLES="userdata"
CONFIG_XNU_SOURCE_STORAGE_POLICIES="OS"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sheng-source-storage/libShengSourceStorage.a"
